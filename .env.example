# =====================================================================
# Contoh variabel lingkungan untuk lingkungan tes.
# Salin ke .env bila perlu. Nilai default sudah ada di docker-compose.yml.
# =====================================================================

# Port host untuk dashboard (browser buka http://localhost:8080)
DASHBOARD_PORT=8080

